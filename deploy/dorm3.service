[Unit]
Description=Dorm 3 relay chat
After=network-online.target
Wants=network-online.target

[Service]
User=dorm3
Group=dorm3
WorkingDirectory=/opt/dorm3
ExecStart=/usr/bin/java -Xmx256m -jar /opt/dorm3/dorm3.jar --server.port=80 --messenger.data-file=/var/lib/dorm3/db.json
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
